{
  "name": "flowdjs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "flowd.js — the FlowControl daemon as a Node process: flowcore (wasm) over node:sqlite, serving FlowService (gRPC + grpc-web). A drop-in for the Rust flowd.",
  "engines": {
    "node": ">=22.5"
  },
  "exports": {
    ".": "./src/lib.ts"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "tsx src/index.ts",
    "ui": "tsx src/ui.ts",
    "build": "tsup && node scripts/bundle-wasm.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@flow/api": "workspace:*",
    "@bufbuild/protobuf": "^2.13.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  },
  "files": ["dist"],
  "publishConfig": {
    "main": "./dist/lib.js",
    "types": "./dist/lib.d.ts",
    "exports": {
      ".": {
        "types": "./dist/lib.d.ts",
        "default": "./dist/lib.js"
      }
    },
    "bin": {
      "flowd-js": "./dist/index.js"
    }
  }
}
