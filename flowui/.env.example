# Base URL of the FlowControl core (grpc-web endpoint).
#
# Flowui reads this directly, independent of flowd's own port, so you can point
# the web app at a different core (e.g. one instance for flowui and one for
# flowcli). Defaults to the common flowd port (50051). Copy to .env to change.
#
# Demo mode (VITE_DEMO=1, via build:demo --mode demo) ignores this entirely and
# uses the in-memory fixture store.
VITE_SERVER_URL=http://127.0.0.1:50051
