# flowd core server port.
#
# docker compose reads this file (from the repo root) and uses the variable to
# publish the host port and tell `flowd serve` which address to bind inside the
# container. Native `flowd serve` keeps its own --addr default.
FLOWD_PORT=50051

# Address flowmcp (the MCP server) uses to reach flowd over gRPC (native h2c).
# Defaults to http://127.0.0.1:50051; a Dockerized flowd publishes FLOWD_PORT to
# the host, so the default works when `docker compose up flowd` is running.
FLOWD_ADDR=http://127.0.0.1:50051
