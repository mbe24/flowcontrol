# Address flowcli connects to. Default points at the host's published core (the
# web app's flowd, started with `docker compose up` in the repo root) - so the
# CLI shares that one instance and no dedicated server is started. A literal
# -addr flag always wins over this.
# For native (non-container) runs use instead, e.g.: FLOWCLI_ADDR=127.0.0.1:50051
FLOWCLI_ADDR=host.docker.internal:50051

# Only used by the optional dedicated core (`docker compose --profile dedicated`
# in flowcli/): the host port that dedicated flowd binds/publishes. Keep it
# distinct (e.g. 50052) if the web core (50051) is also running.
FLOWCLI_FLOWD_PORT=50052
