    "test:watch": "vitest",
    "test:integration": "vitest run src/integration.test.ts"
  },
  "dependencies": {
    "@flow/api": "0.1.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2",
    "@bufbuild/protobuf": "^2.13.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.1.2",
    "fast-check": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
